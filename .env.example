# Skopiuj do .env.local i uzupełnij (zob. README).
# Projekt Supabase: Project Settings → API / Connect.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tylko serwer. Nigdy nie dodawaj prefiksu NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Pula transakcyjna (Supavisor, port 6543), z hasłem bazy.
DATABASE_URL=postgresql://postgres.<ref>:<haslo>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
