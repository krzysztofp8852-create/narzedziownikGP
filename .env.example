# Skopiuj do .env.local i uzupełnij (zob. README).
# Projekt Supabase: Project Settings → API / Connect.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tylko serwer. Nigdy nie dodawaj prefiksu NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Pula transakcyjna (Supavisor, port 6543), z hasłem bazy.
DATABASE_URL=postgresql://postgres.<ref>:<haslo>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# Powiadomienia e-mail (Resend, domena nadawcy zweryfikowana w Resend). Bez klucza trafiają tylko do logu.
RESEND_API_KEY=
NOTIFICATIONS_FROM="NarzędziownikGP <powiadomienia@twoja-domena.pl>"
# Adres aplikacji w kodach QR naklejek. Pusty: adres, z którego otwarto aplikację.
APP_URL=
# Wpis tekstem z AI (OpenAI API; model domyślnie gpt-5.4-mini, inny w OPENAI_MODEL). Bez klucza wpis tekstem
# jest wyłączony, chyba że lokalnie ustawisz TEXT_ENTRY_INTERPRETER=slowa (słowa kluczowe, bez AI).
OPENAI_API_KEY=
OPENAI_MODEL=
TEXT_ENTRY_INTERPRETER=
# Nagrywanie głosu: dostawca transkrypcji. Domyślnie openai (gdy jest OPENAI_API_KEY; model gpt-4o-transcribe,
# inny w OPENAI_TRANSCRIPTION_MODEL) albo elevenlabs (ELEVENLABS_API_KEY; model scribe_v2, inny w ELEVENLABS_MODEL).
# Lokalnie bez AI: TRANSCRIPTION_PROVIDER=staly i TRANSCRIPTION_FIXED_TEXT (każde nagranie to ten tekst).
TRANSCRIPTION_PROVIDER=
OPENAI_TRANSCRIPTION_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=
TRANSCRIPTION_FIXED_TEXT=
# Zadania harmonogramu Vercel Cron (vercel.json), np. dzienne powiadomienia o przekroczonym progu dni.
# Vercel wysyła go w nagłówku Authorization; bez niego zadania są wyłączone. Lokalnie:
# curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/zadania/progi
CRON_SECRET=
