# Skopiuj do .env.local i uzupełnij (zob. README). Tu tylko lokalne albo testowe Supabase (narzedziownik-test);
# klucze produkcji są w zmiennych Vercel Production i w .env.produkcja dla skryptów `:prod` (zob. docs/adr/0039).
# Projekt Supabase: Project Settings → API / Connect.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tylko serwer. Nigdy nie dodawaj prefiksu NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Pula transakcyjna (Supavisor, port 6543), z hasłem bazy.
DATABASE_URL=postgresql://postgres.<ref>:<haslo>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# Powiadomienia e-mail (Resend, domena nadawcy zweryfikowana w Resend). Bez klucza trafiają tylko do logu.
RESEND_API_KEY=
NOTIFICATIONS_FROM="NarzędziownikGP <powiadomienia@twoja-domena.pl>"
# Powiadomienia push: klucze VAPID z `npx web-push generate-vapid-keys` i kontakt dla usług push (mailto: albo https:).
# Bez kluczy włączanie powiadomień jest ukryte, a kopie push trafiają tylko do logu.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:powiadomienia@twoja-domena.pl
# Powiadomienia w aplikacji na Androida (FCM): cały plik JSON klucza konta serwisowego Firebase w jednej linii.
# Bez niego kopie push na aplikację trafiają tylko do logu.
FIREBASE_SERVICE_ACCOUNT=
# Czat z supportem: adres GP Engineering na wiadomości użytkowników (e-mailem przez Resend; bez niego tylko do logu)
# i telefon w stopce okna czatu (bez niego stopki nie ma).
SUPPORT_EMAIL=
SUPPORT_PHONE=
# Adres aplikacji w kodach QR naklejek, w mapie strony i w podglądzie linku strony o programie. Pusty: adres, z którego
# otwarto aplikację (mapa strony i podgląd linku: adres produkcji na Vercelu).
APP_URL=
# Google Search Console, weryfikacja tagiem HTML: sama wartość `content` z podanego znacznika meta. Pusty: bez znacznika
# (np. przy weryfikacji domeny rekordem DNS).
GOOGLE_SITE_VERIFICATION=
# Wpis tekstem z AI (OpenAI API; model domyślnie gpt-5.4-mini, inny w OPENAI_MODEL). Bez klucza wpis tekstem
# jest wyłączony, chyba że lokalnie ustawisz TEXT_ENTRY_INTERPRETER=slowa (słowa kluczowe, bez AI).
OPENAI_API_KEY=
OPENAI_MODEL=
TEXT_ENTRY_INTERPRETER=
# Nagrywanie głosu: dostawca transkrypcji. Domyślnie openai (gdy jest OPENAI_API_KEY; model gpt-4o-transcribe,
# inny w OPENAI_TRANSCRIPTION_MODEL) albo elevenlabs (ELEVENLABS_API_KEY; model scribe_v2, inny w ELEVENLABS_MODEL).
# Lokalnie bez AI: TRANSCRIPTION_PROVIDER=staly i TRANSCRIPTION_FIXED_TEXT (każde nagranie to ten tekst).
TRANSCRIPTION_PROVIDER=
OPENAI_TRANSCRIPTION_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=
TRANSCRIPTION_FIXED_TEXT=
# Mapa budów na tablicy (Google Maps Platform, zob. docs/adr/0026). Klucz przeglądarki z samym Maps JavaScript API,
# ograniczony do adresów aplikacji, i identyfikator mapy (Map ID; pusty: DEMO_MAP_ID, tylko do prób). Bez klucza
# przeglądarki prawdziwe firmy nie mają mapy. Klucz serwera z samym Geocoding API zamienia adresy budów i bazy na
# punkty; bez niego budowy nie mają położenia, dopóki właściciel nie postawi pinezki. Lokalnie bez Google:
# GEOCODER=staly (każdy adres w środku Poznania).
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_SERVER_KEY=
GEOCODER=
# Zadania harmonogramu Vercel Cron (vercel.json), np. dzienne powiadomienia o przekroczonym progu dni, i godzinowe
# odświeżanie demo z GitHub Actions (.github/workflows/demo.yml, ta sama wartość w sekretach repozytorium).
# Vercel wysyła go w nagłówku Authorization; bez niego zadania są wyłączone. Lokalnie:
# curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/zadania/progi
CRON_SECRET=
